# This app's own public URL (used for absolute-URL generation: sitemap, JSON-LD, meta).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Base URL of the Laravel API (fastora-backend) that now serves all content —
# server-side only, nothing here is exposed to the browser.
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Bearer token the Laravel API uses to authenticate calls to /api/revalidate
# (see src/app/(frontend)/api/revalidate/route.ts). Must match fastora-backend's
# FASTORA_API_TOKEN.
FASTORA_API_TOKEN=

# Google Analytics 4 measurement ID (optional). Leave blank or leave the
# placeholder in place and analytics stays completely off — no script loaded, no
# request to Google. Paste a real "G-" ID to switch it on; it then only runs for
# visitors who accept the cookie banner. Ignored in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact-form admin notification email (optional — submissions still save
# without it, this just enables the "New inquiry" email).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
