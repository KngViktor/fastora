{
  "name": "fastora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:server": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation node server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "comments": {
    "overrides": "brace-expansion 1.1.18 is the last of the 1.x line and carries CVE-2026-14257 (denial of service through unbounded expansion) with no 1.x patch. It reaches this project only through eslint's minimatch@3, so it is a devDependency that is never bundled into the site, and npm's own advisory database does not flag it. Pinned forward anyway so a dependency scan of the lockfile comes back clean. minimatch@3 only calls expand(), which 2.x keeps."
  },
  "overrides": {
    "brace-expansion": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
